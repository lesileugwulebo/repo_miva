project_name = "secure-multicloud"
environment  = "lab"

aws_region     = "us-east-1"
azure_location = "eastus"

azure_subscription_id = "REPLACE_WITH_AZURE_SUBSCRIPTION_ID"
azure_tenant_id       = "REPLACE_WITH_AZURE_TENANT_ID"

administrator_cidr = "REPLACE_WITH_APPROVED_IP/32"

database_name     = "enterprise_lab"
database_username = "app_user"

# Supply strong secrets in environment variables or uncommitted tfvars
database_password = "SUPPLY_THROUGH_ENV_OR_TFVARS_MIN_16_CHARS"
vpn_shared_key_1  = "SUPPLY_THROUGH_ENV_OR_TFVARS_MIN_16_CHARS"
vpn_shared_key_2  = "SUPPLY_THROUGH_ENV_OR_TFVARS_MIN_16_CHARS"

enable_guardduty = true
enable_defender  = true
